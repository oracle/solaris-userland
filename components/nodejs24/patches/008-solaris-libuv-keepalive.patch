Solaris ships shared libuv 1.51, which lacks uv_tcp_keepalive_ex().
Use uv_tcp_keepalive() for the existing handle state and idle delay, and
set the Solaris 11.4 TCP_KEEPINTVL and TCP_KEEPCNT socket options directly.
Match libuv 1.52's interval limits and retain configurable probe counts.
The newer libuv path is unchanged.

The addon regression test reads the actual kernel socket options after
pre-connect configuration, reconfiguration, default restoration, and disabling.

--- node-24.22.1/src/tcp_wrap.cc
+++ node-24.22.1/src/tcp_wrap.cc
@@ -41,6 +41,9 @@
 #include <netinet/in.h>
 #include <netinet/ip.h>
 #include <netinet/ip6.h>
+#ifdef __sun
+#include <netinet/tcp.h>
+#endif
 #include <sys/socket.h>
 #include <unistd.h>  // dup(), close()
 #endif
@@ -216,7 +219,35 @@
   unsigned int count = 10;
   if (args[2]->IsUint32()) interval = args[2].As<Uint32>()->Value();
   if (args[3]->IsUint32()) count = args[3].As<Uint32>()->Value();
+#if defined(__sun) && UV_VERSION_HEX < 0x013400
+  // libuv before 1.52 has no uv_tcp_keepalive_ex(). Keep its handle flags
+  // and idle-delay handling, then set the Solaris 11.4 probe options.
+  int err = uv_tcp_keepalive(&wrap->handle_, enable, delay);
+  if (err == 0 && enable) {
+    uv_os_fd_t fd;
+    int fd_err = uv_fileno(reinterpret_cast<uv_handle_t*>(&wrap->handle_), &fd);
+    // net.Socket replays these options after connect if no socket exists yet.
+    if (fd_err == 0) {
+      if (interval == 0 || count == 0) {
+        err = UV_EINVAL;
+      } else {
+        // Match libuv 1.52's Solaris limits: ten seconds to ten days.
+        if (interval < 10) interval = 10;
+        if (interval > 10 * 24 * 60 * 60) interval = 10 * 24 * 60 * 60;
+        if (setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL,
+                       &interval, sizeof(interval)) != 0 ||
+            setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT,
+                       &count, sizeof(count)) != 0) {
+          err = uv_translate_sys_error(errno);
+        }
+      }
+    } else if (fd_err != UV_EBADF) {
+      err = fd_err;
+    }
+  }
+#else
   int err = uv_tcp_keepalive_ex(&wrap->handle_, enable, delay, interval, count);
+#endif
   args.GetReturnValue().Set(err);
 }
 

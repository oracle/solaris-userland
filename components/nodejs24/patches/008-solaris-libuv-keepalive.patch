@@ -0,0 +1,35 @@
+#include <node.h>
+#ifdef __sun
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+static void GetOptions(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  v8::Isolate* isolate = args.GetIsolate();
+  auto context = isolate->GetCurrentContext();
+  int fd = args[0]->Int32Value(context).FromJust();
+  const int levels[] = {SOL_SOCKET, IPPROTO_TCP, IPPROTO_TCP, IPPROTO_TCP};
+  const int options[] = {SO_KEEPALIVE, TCP_KEEPIDLE, TCP_KEEPINTVL, TCP_KEEPCNT};
+  auto result = v8::Array::New(isolate, 4);
+  for (unsigned int i = 0; i < 4; i++) {
+    int value = 0;
+    socklen_t size = sizeof(value);
+    if (getsockopt(fd, levels[i], options[i], &value, &size) != 0) {
+      isolate->ThrowException(v8::Exception::Error(
+          v8::String::NewFromUtf8Literal(isolate, "getsockopt failed")));
+      return;
+    }
+    result->Set(context, i, v8::Integer::New(
+        isolate, i == 0 ? value != 0 : value)).Check();
+  }
+  args.GetReturnValue().Set(result);
+}
+#endif
+
+static void Initialize(v8::Local<v8::Object> exports) {
+#ifdef __sun
+  NODE_SET_METHOD(exports, "getOptions", GetOptions);
+#endif
+}
+
+NODE_MODULE(NODE_GYP_MODULE_NAME, Initialize)

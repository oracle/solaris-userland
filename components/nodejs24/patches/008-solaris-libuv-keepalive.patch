@@ -0,0 +1,25 @@
+'use strict';
+
+const common = require('../../common');
+if (!common.isSunOS) common.skip('Solaris socket options');
+const assert = require('assert');
+const net = require('net');
+const binding = require(`./build/${common.buildType}/binding`);
+
+const server = net.createServer();
+server.listen(0, common.mustCall(() => {
+  const client = new net.Socket();
+  client.setKeepAlive(true, 5000, 37000, 6);
+  client.connect(server.address().port, common.mustCall(() => {
+    const options = () => binding.getOptions(client._handle.fd);
+    assert.deepStrictEqual(options(), [1, 10, 37, 6]);
+    client.setKeepAlive(true, 5000);
+    assert.deepStrictEqual(options(), [1, 10, 10, 10]);
+    client.setKeepAlive(true, 12000, 12000, 3);
+    assert.deepStrictEqual(options(), [1, 12, 12, 3]);
+    client.setKeepAlive(false);
+    assert.strictEqual(options()[0], 0);
+    client.end();
+  }));
+  client.on('close', common.mustCall(() => server.close()));
+}));

Upstream: https://github.com/rockdaboot/libpsl/commit/d6d9dd37b981d2866d9ecb9e1455b475a1252d20
Hunk positions refreshed for libpsl 0.23.3; no code changes.

From d6d9dd37b981d2866d9ecb9e1455b475a1252d20 Mon Sep 17 00:00:00 2001
From: Radhika <radhika@research.itecz.au>
Date: Fri, 23 Oct 2026 16:00:16 +0530
Subject: [PATCH] is_public_suffix: ignore the trailing dot in the wildcard
 lookup

The first lookup strips a single trailing dot, but the wildcard lookup
recomputed the length with strlen() and got the dot back, so "foo.ck."
did not match "*.ck". The punycode branch had the same problem.

Derive the second lookup's length from the first one and strip the
trailing dot from the punycode result as well.
---
 src/psl.c                                | 14 ++++++++------
 tests/test-is-cookie-domain-acceptable.c |  2 ++
 tests/test-is-public-builtin.c           |  1 +
 tests/test-is-public.c                   |  1 +
 4 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/src/psl.c b/src/psl.c
index b668f165..3fd8fc2d 100644
--- a/src/psl.c
+++ b/src/psl.c
@@ -891,6 +891,8 @@ static int is_public_suffix(const psl_ctx_t *psl, const char *domain, int type)
 		if (psl_idna_toASCII(idna, domain, &punycode) == 0) {
 			suffix.label = punycode;
 			suffix.length = strlen(punycode);
+			if (suffix.length > 0 && punycode[suffix.length - 1] == '.')
+				suffix.length--;
 		} else {
 			/* fallback */
 
@@ -922,9 +924,9 @@ static int is_public_suffix(const psl_ctx_t *psl, const char *domain, int type)
 			/* definitely a match, no matter if the found rule is a wildcard or not */
 			goto suffix_yes;
 		}
-		if ((suffix.label = strchr(suffix.label, '.'))) {
-			suffix.label++;
-			suffix.length = strlen(suffix.label);
+		if ((p = memchr(suffix.label, '.', suffix.length))) {
+			suffix.length -= p + 1 - suffix.label;
+			suffix.label = p + 1;
 			suffix.nlabels--;
 
 			rc = LookupStringInFixedSet(dafsa, dafsa_size, suffix.label, suffix.length);
@@ -962,9 +964,9 @@ static int is_public_suffix(const psl_ctx_t *psl, const char *domain, int type)
 			goto suffix_yes;
 		}
 
-		if ((suffix.label = strchr(suffix.label, '.'))) {
-			suffix.label++;
-			suffix.length = strlen(suffix.label);
+		if ((p = memchr(suffix.label, '.', suffix.length))) {
+			suffix.length -= p + 1 - suffix.label;
+			suffix.label = p + 1;
 			suffix.nlabels--;
 
 			rule = vector_get(psl->suffixes, vector_find(psl->suffixes, &suffix));
diff --git a/tests/test-is-cookie-domain-acceptable.c b/tests/test-is-cookie-domain-acceptable.c
index 4df5bd7a..a86d245a 100644
--- a/tests/test-is-cookie-domain-acceptable.c
+++ b/tests/test-is-cookie-domain-acceptable.c
@@ -50,6 +50,8 @@ static void test_psl(void)
 		{ "www.example.com", "example.org", 0 },
 		{ "www.sa.gov.au", "sa.gov.au", 0 }, /* not accepted by normalization  (PSL rule '*.ar') */
 		{ "www.educ.ar", "educ.ar", 1 }, /* PSL exception rule '!educ.ar' */
+		{ "www.xxx.ck", "xxx.ck", 0 }, /* PSL wildcard rule '*.ck' */
+		{ "www.xxx.ck.", "xxx.ck.", 0 }, /* same with trailing dot */
 		/* RFC6265 5.1.3: Having IP addresses, request and domain IP must be identical */
 		{ "192.1.123.2", ".1.123.2", 0 }, /* IPv4 address, partial match */
 		{ "192.1.123.2", "192.1.123.2", 1 }, /* IPv4 address, full match */
diff --git a/tests/test-is-public-builtin.c b/tests/test-is-public-builtin.c
index f2fea5b5..02d31910 100644
--- a/tests/test-is-public-builtin.c
+++ b/tests/test-is-public-builtin.c
@@ -47,6 +47,7 @@ static void test_psl(void)
 		{ "www.ck", 0, 0 }, /* exception from *.ck */
 		{ "abc.www.ck", 0, 0 },
 		{ "xxx.ck", 1, 1 },
+		{ "xxx.ck.", 1, 1 }, /* trailing dot must not matter for wildcard rules */
 		{ "www.xxx.ck", 0, 0 },
 		{ "\345\225\206\346\240\207", 1, 1 }, /* xn--czr694b or ?? */
 		{ "www.\345\225\206\346\240\207", 0, 0 },
diff --git a/tests/test-is-public.c b/tests/test-is-public.c
index e568e828..a3bdefab 100644
--- a/tests/test-is-public.c
+++ b/tests/test-is-public.c
@@ -51,6 +51,7 @@ static void test_psl(void)
 		{ "www.ck", 0, 0 }, /* exception from *.ck */
 		{ "abc.www.ck", 0, 0 },
 		{ "xxx.ck", 1, 1 },
+		{ "xxx.ck.", 1, 1 }, /* trailing dot must not matter for wildcard rules */
 		{ "www.xxx.ck", 0, 0 },
 		{ "\345\225\206\346\240\207", 1, 1 }, /* xn--czr694b or ?? */
 		{ "www.\345\225\206\346\240\207", 0, 0 },

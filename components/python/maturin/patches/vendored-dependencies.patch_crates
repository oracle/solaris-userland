Adapt python-pkginfo to the fixed zip dependency used by maturin.

--- a/python-pkginfo/Cargo.toml
+++ b/python-pkginfo/Cargo.toml
@@ -78,7 +78,7 @@
 package = "xz2"
 
 [dependencies.zip]
-version = ">=0.6,<9"
+version = "9.1.3"
 features = ["deflate"]
 default-features = false
 
--- a/python-pkginfo/src/distribution.rs
+++ b/python-pkginfo/src/distribution.rs
@@ -203,8 +203,9 @@
     fn parse_zip(path: &Path, metadata_file_suffix: &str) -> Result<Metadata, Error> {
         let reader = BufReader::new(fs_err::File::open(path)?);
         let mut archive = ZipArchive::new(reader)?;
-        let metadata_files: Vec<_> = archive
-            .file_names()
+        let file_names = archive.file_names().collect::<Result<Vec<_>, _>>()?;
+        let metadata_files: Vec<_> = file_names
+            .iter()
             .filter(|name| name.ends_with(metadata_file_suffix))
             .map(ToString::to_string)
             .collect();
--- a/python-pkginfo/.cargo-checksum.json
+++ b/python-pkginfo/.cargo-checksum.json
@@ -1 +1 @@

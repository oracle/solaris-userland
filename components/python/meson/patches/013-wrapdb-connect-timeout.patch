The WrapDB connectivity check can wait indefinitely when the host cannot
complete a TCP connection. Bound the check so the test skips promptly on
build hosts without external network access.

---
--- a/unittests/platformagnostictests.py
+++ b/unittests/platformagnostictests.py
@@ -138,7 +138,7 @@
     def check_connectivity(self):
         import urllib
         try:
-            with urllib.request.urlopen('https://wrapdb.mesonbuild.com') as p:
+            with urllib.request.urlopen('https://wrapdb.mesonbuild.com', timeout=15) as p:
                 pass
         except urllib.error.URLError as e:
             self.skipTest('No internet connectivity: ' + str(e))

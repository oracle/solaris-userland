From 1fe62e52935d3ff4f474f507d4239e58bcd308a7 Mon Sep 17 00:00:00 2001
From: Dave Vasilevsky <dave@vasilevsky.ca>
Date: Sat, 8 Mar 2025 02:16:50 -0500
Subject: [PATCH] OOM-safety


Upstream: https://github.com/vasi/pixz/commit/1fe62e52935d3ff4f474f507d4239e58bcd308a7

Refreshed against 1.0.7 after 01 and 02 for source context and line offsets.
The existing queue locking is retained; the independent upstream queue
optimization 57d9add97fa5c1e1c1349796f1dcd0c6de24eb50 is not required.

---
 src/common.c | 23 +++++++++++++++--------
 src/pixz.c   |  2 +-
 src/pixz.h   |  1 +
 src/read.c   |  6 +++---
 src/write.c  |  8 ++++----
 5 files changed, 24 insertions(+), 16 deletions(-)

diff --git a/src/common.c b/src/common.c
--- a/src/common.c
+++ b/src/common.c
@@ -21,11 +21,18 @@
     exit(1);
 }
 
+void *xmalloc(size_t size) {
+    void *r = malloc(size);
+    if (!r)
+        die("Out of memory");
+    return r;
+}
+
 char *xstrdup(const char *s) {
     if (!s)
         return NULL;
     size_t len = strlen(s);
-    char *r = malloc(len + 1);
+    char *r = xmalloc(len + 1);
     if (!r)
         return NULL;
     return memcpy(r, s, len + 1); 
@@ -91,7 +98,7 @@
         die("Error seeking to block");
     
     // Some memory in which to keep the discovered filters safe
-    block_wrapper_t *bw = malloc(sizeof(block_wrapper_t));
+    block_wrapper_t *bw = xmalloc(sizeof(block_wrapper_t));
     bw->block = (lzma_block){ .check = check, .filters = bw->filters,
 	 	.version = 0 };
     
@@ -128,7 +135,7 @@
     void *bdata = decode_file_index_start(iter.block.compressed_file_offset,
 		iter.stream.flags->check);
     
-    gFileIndexBuf = malloc(gFIBSize);
+    gFileIndexBuf = xmalloc(gFIBSize);
     gStream.avail_out = gFIBSize;
     gStream.avail_in = 0;
     
@@ -164,7 +171,7 @@
         if (!name)
             break;
         
-        file_index_t *f = malloc(sizeof(file_index_t));
+        file_index_t *f = xmalloc(sizeof(file_index_t));
         f->name = strlen(name) ? xstrdup(name) : NULL;
         f->offset = xle64dec(gFileIndexBuf + gFIBPos);
         gFIBPos += sizeof(uint64_t);
@@ -366,7 +373,7 @@
 #pragma mark QUEUE
 
 queue_t *queue_new(queue_free_t freer) {
-    queue_t *q = malloc(sizeof(queue_t));
+    queue_t *q = xmalloc(sizeof(queue_t));
     q->first = q->last = NULL;
     q->freer = freer;
     pthread_mutex_init(&q->mutex, NULL);
@@ -390,7 +397,7 @@
 void queue_push(queue_t *q, int type, void *data) {
     pthread_mutex_lock(&q->mutex);
     
-    queue_item_t *i = malloc(sizeof(queue_item_t));
+    queue_item_t *i = xmalloc(sizeof(queue_item_t));
     i->type = type;
     i->data = data;
     i->next = NULL;
@@ -471,7 +478,7 @@
 	if (gPipelineProcessMax > 0 && gPipelineProcessMax < gPLProcessCount)
 		gPLProcessCount = gPipelineProcessMax;
 	
-    gPLProcessThreads = malloc(gPLProcessCount * sizeof(pthread_t));
+    gPLProcessThreads = xmalloc(gPLProcessCount * sizeof(pthread_t));
     int qsize = gPipelineQSize ? gPipelineQSize
         : ceil(gPLProcessCount * 1.3 + 1);
     if (qsize < gPLProcessCount) {
@@ -480,7 +487,7 @@
     }
     for (size_t i = 0; i < qsize; ++i) {
         // create blocks, including a margin of error
-        pipeline_item_t *item = malloc(sizeof(pipeline_item_t));
+        pipeline_item_t *item = xmalloc(sizeof(pipeline_item_t));
         item->data = create();
         // seq and next are garbage
         queue_push(gPipelineStartQ, PIPELINE_ITEM, item);
diff --git a/src/pixz.c b/src/pixz.c
--- a/src/pixz.c
+++ b/src/pixz.c
@@ -201,7 +201,7 @@
         return NULL;
     
     size_t li = strlen(in), l1 = strlen(suf1), l2 = strlen(suf2);
-    char *r = malloc(li + l2 - l1 + 1);
+    char *r = xmalloc(li + l2 - l1 + 1);
     memcpy(r, in, li - l1);
     strcpy(r + li - l1, suf2);
     return r;
diff --git a/src/pixz.h b/src/pixz.h
--- a/src/pixz.h
+++ b/src/pixz.h
@@ -69,6 +69,7 @@
 
 extern double gBlockFraction;
 
+void *xmalloc(size_t size);
 
 #pragma mark INDEX
 
diff --git a/src/read.c b/src/read.c
--- a/src/read.c
+++ b/src/read.c
@@ -197,7 +197,7 @@
 #pragma mark BLOCKS
 
 static void *block_create(void) {
-    io_block_t *ib = malloc(sizeof(io_block_t));
+    io_block_t *ib = xmalloc(sizeof(io_block_t));
 	ib->incap = ib->outcap = 0;
 	ib->input = ib->output = NULL;
     return ib;
@@ -266,7 +266,7 @@
         }
         
         if (match) {
-            wanted_t *w = malloc(sizeof(wanted_t));
+            wanted_t *w = xmalloc(sizeof(wanted_t));
             *w = (wanted_t){ .name = f->name, .start = f->offset,
                 .end = f->next->offset, .next = NULL };
             w->size = w->end - w->start;
@@ -296,7 +296,7 @@
 	}
 	if (outcap > ib->outcap) {
 		ib->outcap = outcap;
-		ib->output = malloc(outcap);
+		ib->output = xmalloc(outcap);
 	}
 }
 
diff --git a/src/write.c b/src/write.c
--- a/src/write.c
+++ b/src/write.c
@@ -230,7 +230,7 @@
         return;
     }
     
-    file_index_t *f = malloc(sizeof(file_index_t));
+    file_index_t *f = xmalloc(sizeof(file_index_t));
     f->offset = gMultiHeader ? gMultiHeaderStart : offset;
     gMultiHeader = false;
     f->name = name ? xstrdup(name) : NULL;
@@ -252,16 +252,16 @@
 }
 
 static void *block_create() {
-    io_block_t *ib = malloc(sizeof(io_block_t));
+    io_block_t *ib = xmalloc(sizeof(io_block_t));
     ib->input = ib->output = NULL;
     return ib;
 }
 
 static void block_alloc(io_block_t *ib, block_parts parts) {
     if ((parts & BLOCK_IN) && !ib->input)
-        ib->input = malloc(gBlockInSize);
+        ib->input = xmalloc(gBlockInSize);
     if ((parts & BLOCK_IN) && !ib->output)
-        ib->output = malloc(gBlockOutSize);
+        ib->output = xmalloc(gBlockOutSize);
     if (!ib->input || !ib->output)
         die("Can't allocate blocks");
 }

From 165167d77445866cf5d1348e31bb4286329cea2a Mon Sep 17 00:00:00 2001
From: Petr Sumbera <sumbera@volny.cz>
Date: Tue, 24 Nov 2026 16:23:46 +0100
Subject: [PATCH] sunos: retain fork/exec on Oracle Solaris

On Oracle Solaris, posix_spawn() can propagate ENOENT from a
command run by a shell that has already started. uv_spawn() should
report a successful spawn and deliver the shell's exit status.

Use the existing fork/exec path on Oracle Solaris and verify that
a shell whose command is missing exits with status 127.
Upstream: https://github.com/libuv/libuv/pull/5465
---
 src/unix/process.c |  4 ++++
 test/test-list.h   |  6 ++++++
 test/test-spawn.c  | 31 +++++++++++++++++++++++++++++++
 3 files changed, 41 insertions(+)

--- a/src/unix/process.c
+++ b/src/unix/process.c
@@ -490,6 +490,10 @@
    * Unices in that it returns 0 instead of EACCES or ENOENT for paths
    * that don't exist. See https://github.com/libuv/libuv/issues/5240.
    */
+#elif defined(__sun) && !defined(__illumos__)
+  /* Solaris posix_spawn() may return ENOENT when an already started
+   * shell cannot find its command. Use fork() to preserve the shell
+   * exit status. */
 #else
 #if !defined(__linux__) && !defined(_AIX) && !defined(__PASE__)
   posix_spawn_works = 1;
--- a/test/test-list.h
+++ b/test/test-list.h
@@ -345,6 +345,9 @@
 #endif
 TEST_DECLARE   (spawn_empty_env)
 TEST_DECLARE   (spawn_exit_code)
+#if defined(__sun) && !defined(__illumos__)
+TEST_DECLARE   (spawn_shell_command_not_found)
+#endif
 TEST_DECLARE   (spawn_stdout)
 TEST_DECLARE   (spawn_stdin)
 TEST_DECLARE   (spawn_stdio_socket_buffer_size)
@@ -1062,6 +1065,9 @@
 #endif
   TEST_ENTRY  (spawn_empty_env)
   TEST_ENTRY  (spawn_exit_code)
+#if defined(__sun) && !defined(__illumos__)
+  TEST_ENTRY  (spawn_shell_command_not_found)
+#endif
   TEST_ENTRY  (spawn_stdout)
   TEST_ENTRY  (spawn_stdin)
 #ifndef _WIN32
--- a/test/test-spawn.c
+++ b/test/test-spawn.c
@@ -278,6 +278,37 @@
   MAKE_VALGRIND_HAPPY(uv_default_loop());
   return 0;
 }
+
+
+#if defined(__sun) && !defined(__illumos__)
+static void shell_exit_cb(uv_process_t* process,
+                          int64_t exit_status,
+                          int term_signal) {
+  exit_cb_called++;
+  ASSERT_EQ(127, exit_status);
+  ASSERT_OK(term_signal);
+  uv_close((uv_handle_t*) process, close_cb);
+}
+
+
+TEST_IMPL(spawn_shell_command_not_found) {
+  char* shell_args[] = {
+    "/bin/sh", "-c", "./libuv-spawn-missing-dir/command", NULL
+  };
+
+  options.file = shell_args[0];
+  options.args = shell_args;
+  options.exit_cb = shell_exit_cb;
+
+  ASSERT_OK(uv_spawn(uv_default_loop(), &process, &options));
+  ASSERT_OK(uv_run(uv_default_loop(), UV_RUN_DEFAULT));
+  ASSERT_EQ(1, exit_cb_called);
+  ASSERT_EQ(1, close_cb_called);
+
+  MAKE_VALGRIND_HAPPY(uv_default_loop());
+  return 0;
+}
+#endif
 
 
 TEST_IMPL(spawn_stdout) {

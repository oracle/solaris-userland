Support the descriptor-based so_socketpair syscall on newer Solaris.

The legacy syscall takes an int array; newer Solaris takes two existing
descriptors. Probe with invalid descriptors, which yields EBADF for the new
form and EFAULT for the legacy form. Keep the legacy wrapper unchanged.
No corresponding upstream fix is available in the inspected Valgrind git.

--- a/configure.ac
+++ b/configure.ac
@@ -4800,6 +4800,22 @@
 AC_MSG_RESULT([no])
 ])
 
+# Newer Solaris connects two existing descriptors instead of reading an array.
+AC_MSG_CHECKING([if so_socketpair takes two descriptors (Solaris-specific)])
+AC_RUN_IFELSE([AC_LANG_PROGRAM([[
+#include <errno.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+]], [[
+    return syscall(SYS_so_socketpair, -1, -1) != -1 || errno != EBADF;
+]])], [
+AC_MSG_RESULT([yes])
+AC_DEFINE([SOLARIS_SOCKETPAIR_TAKES_FDS], 1,
+          [Define to 1 if so_socketpair takes two file descriptors.])
+], [
+AC_MSG_RESULT([no])
+])
+
 else
 AM_CONDITIONAL(SOLARIS_SUN_STUDIO_AS, false)
 AM_CONDITIONAL(SOLARIS_XPG_SYMBOLS_PRESENT, false)
--- a/coregrind/m_syswrap/syswrap-solaris.c
+++ b/coregrind/m_syswrap/syswrap-solaris.c
@@ -10310,6 +10310,14 @@
 
 PRE(sys_so_socketpair)
 {
+#if defined(SOLARIS_SOCKETPAIR_TAKES_FDS)
+   /* The syscall connects two existing descriptors and returns no new ones. */
+   PRINT("sys_so_socketpair ( %ld, %ld )", SARG1, SARG2);
+   PRE_REG_READ2(long, "socketpair", int, fd1, int, fd2);
+   if (!ML_(fd_allowed)(ARG1, "socketpair", tid, False)
+       || !ML_(fd_allowed)(ARG2, "socketpair", tid, False))
+      SET_STATUS_Failure(VKI_EBADF);
+#else
    /* int so_socketpair(int sv[2]); */
    /* This syscall is used to connect two already created sockets together. */
    PRINT("sys_so_socketpair ( %#lx )", ARG1);
@@ -10323,10 +10331,14 @@
       else if (!ML_(fd_allowed)(fds[1], "socketpair", tid, False))
          SET_STATUS_Failure(VKI_EBADF);
    }
+#endif
 }
 
 POST(sys_so_socketpair)
 {
+   /* The new ABI connects existing descriptors and writes no output array.
+      Only the legacy ABI needs memory and descriptor bookkeeping here. */
+#if !defined(SOLARIS_SOCKETPAIR_TAKES_FDS)
    /* The kernel can return new file descriptors, in such a case we have to
       validate them. */
    int *fds = (int*)ARG1;
@@ -10352,6 +10364,7 @@
       ML_(record_fd_open_nameless)(tid, fds[0]);
       ML_(record_fd_open_nameless)(tid, fds[1]);
    }
+#endif
 }
 
 PRE(sys_bind)

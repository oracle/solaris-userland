# Bug 23712606 - pulseaudio messages - Failed to load module module-detect
#
# pa_module_load() returns negative integer error codes.  Storing its return
# value in pa_error_code_t (an enum containing only non-negative constants)
# makes the "err < 0" test false with current GCC, so real module-load errors
# are silently ignored.  Backport the upstream fix and compare PA_ERR_EXIST
# with the sign used by pa_module_load().
#
# Headless systems legitimately lack OSS devices and detectable sound hardware,
# and a desktop session can legitimately lack ConsoleKit.  Make only these
# optional loads non-fatal and immediately restore the default fail-on-error
# setting.  Loads made under .nofail retain their detailed debug diagnostic but
# do not add the generic "Module load failed" error to the startup output.  Keep
# the expected no-hardware diagnostic at debug level.  Solaris stopped shipping
# the obsolete module-solaris in bug 25789688, so do not try to load it merely
# because /dev/audio exists.
#
# Upstream fix:
# https://gitlab.freedesktop.org/pulseaudio/pulseaudio/-/commit/6c77b0191a6be390cc1cef2f7da7ba202ab86a92

--- a/src/pulsecore/cli-command.c
+++ b/src/pulsecore/cli-command.c
@@ -421,7 +421,7 @@
 
 static int pa_cli_command_load(pa_core *c, pa_tokenizer *t, pa_strbuf *buf, bool *fail) {
     const char *name;
-    pa_error_code_t err;
+    int err;
     pa_module *m = NULL;
 
     pa_core_assert_ref(c);
@@ -435,10 +435,11 @@
     }
 
     if ((err = pa_module_load(&m, c, name,  pa_tokenizer_get(t, 2))) < 0) {
-        if (err == PA_ERR_EXIST) {
+        if (err == -PA_ERR_EXIST) {
             pa_strbuf_puts(buf, "Module already loaded; ignoring.\n");
         } else {
-            pa_strbuf_puts(buf, "Module load failed.\n");
+            if (*fail)
+                pa_strbuf_puts(buf, "Module load failed.\n");
             return -1;
         }
     }


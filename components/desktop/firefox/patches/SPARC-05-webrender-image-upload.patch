 using namespace mozilla::layers;
 
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+static bool ConvertNativeEndianHostARGBForWebRender(
+    const ImageDescriptor& aDescriptor, Range<uint8_t> aBytes,
+    ImageDescriptor* aOutDescriptor, nsTArray<uint8_t>* aOutBytes) {
+  if (aDescriptor.format != static_cast<ImageFormat>(0) ||
+      aDescriptor.width <= 0 || aDescriptor.height <= 0) {
+    return false;
+  }
+
+  CheckedInt<uint32_t> minStride =
+      CheckedInt<uint32_t>(aDescriptor.width) * 4;
+  if (!minStride.isValid()) {
+    return false;
+  }
+
+  uint32_t stride = aDescriptor.stride ? aDescriptor.stride : minStride.value();
+  if (stride < minStride.value()) {
+    return false;
+  }
+
+  CheckedInt<size_t> requiredBytes =
+      CheckedInt<size_t>(stride) * aDescriptor.height;
+  if (!requiredBytes.isValid() || aBytes.length() < requiredBytes.value()) {
+    return false;
+  }
+
+  if (!aOutBytes->SetLength(requiredBytes.value(), fallible)) {
+    return false;
+  }
+
+  gfx::SurfaceFormat srcFormat =
+      aDescriptor.opacity == OpacityType::Opaque
+          ? gfx::SurfaceFormat::X8R8G8B8
+          : gfx::SurfaceFormat::A8R8G8B8;
+  gfx::SurfaceFormat dstFormat =
+      aDescriptor.opacity == OpacityType::Opaque
+          ? gfx::SurfaceFormat::B8G8R8X8
+          : gfx::SurfaceFormat::B8G8R8A8;
+
+  if (!gfx::SwizzleData(aBytes.begin().get(), stride, srcFormat,
+                        aOutBytes->Elements(), stride, dstFormat,
+                        gfx::IntSize(aDescriptor.width,
+                                     aDescriptor.height))) {
+    aOutBytes->Clear();
+    return false;
+  }
+
+  *aOutDescriptor = aDescriptor;
+  aOutDescriptor->format = ImageFormat::BGRA8;
+  return true;
+}
+#endif

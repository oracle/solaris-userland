Keep SWGL BGRA byte layout endian-safe.

SWGL's RGBA8 buffers are stored in BGRA byte order.  Most packed-byte paths
already operate on bytes and are endian-neutral, but a few scalar uint32_t
helpers still decoded, converted, or cleared pixels as if those BGRA bytes were
loaded on a little-endian host.

On SPARC this makes scalar texture sampling and clears read alpha and color
components from the wrong byte positions.  That affects live WebRender/SWGL
presentation paths such as canvas-backed tab previews and native-looking
controls, while headless Moz2D screenshots can still look correct.

This is a byte-order fix rather than a Solaris/SPARC policy decision, so the
code branches on the compiler byte-order macros.

Dependency: independent of the Cairo format patches. It fixes SWGL's scalar
BGRA byte interpretation directly, and later SWGL texture boundary patches
assume this byte-order handling is correct.

--- firefox-153.0/gfx/wr/swgl/src/gl.cc
+++ firefox-153.0/gfx/wr/swgl/src/gl.cc
@@ -1683,17 +1683,35 @@ return false;
   }
 }
 
+static inline uint32_t pack_bgra8(uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+  return (uint32_t(a) << 24) | (uint32_t(r) << 16) | (uint32_t(g) << 8) | b;
+#else
+  return (uint32_t(b) << 24) | (uint32_t(g) << 16) | (uint32_t(r) << 8) | a;
+#endif
+}
+
 static inline void copy_bgra8_to_rgba8(uint32_t* dest, const uint32_t* src,
                                        int width) {
   for (; width >= 4; width -= 4, dest += 4, src += 4) {
     U32 p = unaligned_load<U32>(src);
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
     U32 rb = p & 0x00FF00FF;
     unaligned_store(dest, (p & 0xFF00FF00) | (rb << 16) | (rb >> 16));
+#else
+    unaligned_store(dest, (p & 0x00FF00FF) | ((p & 0x0000FF00) << 16) |
+                              ((p & 0xFF000000) >> 16));
+#endif
   }
   for (; width > 0; width--, dest++, src++) {
     uint32_t p = *src;
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
     uint32_t rb = p & 0x00FF00FF;
     *dest = (p & 0xFF00FF00) | (rb << 16) | (rb >> 16);
+#else
+    *dest = (p & 0x00FF00FF) | ((p & 0x0000FF00) << 16) |
+            ((p & 0xFF000000) >> 16);
+#endif
   }
 }
 

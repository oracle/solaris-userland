-    // Let's see if we can get a no-copy TextureClient from the canvas.
+#if defined(XP_SOLARIS) && (defined(__sparc) || defined(__sparc__))
+    const bool snapshotSharedProvider = provider && provider->IsShared();
+#else
+    const bool snapshotSharedProvider = false;
+#endif
+
     bool lostFrontTexture = false;
-    auto tc = fnGetExistingTc(desc, lostFrontTexture);
-    if (lostFrontTexture) {
-      // Device reset could cause this.
-      return;
+    RefPtr<TextureClient> tc;
+    if (snapshotSharedProvider) {
+      // The snapshot path reads the current canvas contents and copies them
+      // into a texture owned by this async canvas pipeline.
+      tc = fnMakeTcFromSnapshot();
+    } else {
+      // Let's see if we can get a no-copy TextureClient from the canvas.
+      tc = fnGetExistingTc(desc, lostFrontTexture);
+      if (lostFrontTexture) {
+        // Device reset could cause this.
+        return;
+      }
     }
     if (!tc) {
-      // Otherwise, snapshot the surface and copy into a TexClient.
+      // Otherwise, snapshot the surface and copy into a TextureClient.
       tc = fnMakeTcFromSnapshot();
     }

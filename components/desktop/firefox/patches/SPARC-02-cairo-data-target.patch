 /*
  * Encapsulate the given _aSurface_ into a layers::SourceSurfaceImage.
  */
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+static SurfaceFormat SharedImageBitmapFormat(SurfaceFormat aFormat) {
+  switch (aFormat) {
+    case SurfaceFormat::A8R8G8B8:
+      return SurfaceFormat::B8G8R8A8;
+    case SurfaceFormat::X8R8G8B8:
+      return SurfaceFormat::B8G8R8X8;
+    default:
+      return aFormat;
+  }
+}
+
+static already_AddRefed<SourceSurface> NormalizeImageBitmapSurface(
+    SourceSurface* aSurface) {
+  SurfaceFormat srcFormat = aSurface->GetFormat();
+  SurfaceFormat destFormat = SharedImageBitmapFormat(srcFormat);
+  if (srcFormat == destFormat) {
+    RefPtr<SourceSurface> surface = aSurface;
+    return surface.forget();
+  }
+
+  RefPtr<DataSourceSurface> srcSurface = aSurface->GetDataSurface();
+  if (!srcSurface) {
+    return nullptr;
+  }
+
+  DataSourceSurface::ScopedMap srcMap(srcSurface, DataSourceSurface::READ);
+  if (!srcMap.IsMapped()) {
+    return nullptr;
+  }
+
+  RefPtr<DataSourceSurface> destSurface =
+      Factory::CreateDataSourceSurfaceWithStride(
+          srcSurface->GetSize(), destFormat, srcMap.GetStride());
+  if (!destSurface) {
+    return nullptr;
+  }
+
+  DataSourceSurface::ScopedMap destMap(destSurface, DataSourceSurface::WRITE);
+  if (!destMap.IsMapped()) {
+    return nullptr;
+  }
+
+  if (!SwizzleData(srcMap.GetData(), srcMap.GetStride(), srcFormat,
+                   destMap.GetData(), destMap.GetStride(), destFormat,
+                   srcSurface->GetSize())) {
+    return nullptr;
+  }
+
+  return destSurface.forget();
+}
+#endif

+UniquePtr<uint8_t[]> SurfaceToPackedHostARGB(DataSourceSurface* aSurface) {
+  SurfaceFormat format = aSurface->GetFormat();
+  if (format != SurfaceFormat::B8G8R8A8 &&
+      format != SurfaceFormat::B8G8R8X8 &&
+      format != SurfaceFormat::A8R8G8B8 &&
+      format != SurfaceFormat::X8R8G8B8) {
+    return nullptr;
+  }
+
+  IntSize size = aSurface->GetSize();
+  if (size.width < 0 || size.width >= INT32_MAX / 4) {
+    return nullptr;
+  }
+  int32_t stride = size.width * 4;
+  CheckedInt<size_t> bufferSize =
+      CheckedInt<size_t>(stride) * CheckedInt<size_t>(size.height);
+  if (!bufferSize.isValid()) {
+    return nullptr;
+  }
+  UniquePtr<uint8_t[]> imageBuffer(new (std::nothrow)
+                                       uint8_t[bufferSize.value()]);
+  if (!imageBuffer) {
+    return nullptr;
+  }
+
+  DataSourceSurface::MappedSurface map;
+  if (!aSurface->Map(DataSourceSurface::MapType::READ, &map)) {
+    return nullptr;
+  }
+
+  for (int32_t y = 0; y < size.height; ++y) {
+    const uint8_t* src = map.mData + y * map.mStride;
+    uint8_t* dst = imageBuffer.get() + y * stride;
+    for (int32_t x = 0; x < size.width; ++x) {
+      uint8_t a;
+      uint8_t r;
+      uint8_t g;
+      uint8_t b;
+      switch (format) {
+        case SurfaceFormat::B8G8R8A8:
+          b = src[0];
+          g = src[1];
+          r = src[2];
+          a = src[3];
+          break;
+        case SurfaceFormat::B8G8R8X8:
+          b = src[0];
+          g = src[1];
+          r = src[2];
+          a = 0xFF;
+          break;
+        case SurfaceFormat::A8R8G8B8:
+          a = src[0];
+          r = src[1];
+          g = src[2];
+          b = src[3];
+          break;
+        case SurfaceFormat::X8R8G8B8:
+          a = 0xFF;
+          r = src[1];
+          g = src[2];
+          b = src[3];
+          break;
+        default:
+          MOZ_ASSERT_UNREACHABLE("Unsupported host ARGB source format");
+          aSurface->Unmap();
+          return nullptr;
+      }
+
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+      dst[0] = a;
+      dst[1] = r;
+      dst[2] = g;
+      dst[3] = b;
+#else
+      dst[0] = b;
+      dst[1] = g;
+      dst[2] = r;
+      dst[3] = a;
+#endif
+      src += 4;
+      dst += 4;
+    }
+  }
+
+  aSurface->Unmap();
+  return imageBuffer;
+}

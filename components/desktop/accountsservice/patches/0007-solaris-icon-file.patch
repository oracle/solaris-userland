+#ifdef __sun
+static gint
+open_temporary_icon_file (GError **error)
+{
+        g_autofree gchar *filename = NULL;
+        gint fd;
+
+        filename = g_build_filename (g_get_tmp_dir (), "accountsservice-icon-XXXXXX", NULL);
+        fd = g_mkstemp_full (filename, O_RDWR | O_CLOEXEC, 0600);
+        if (fd < 0) {
+                int saved_errno = errno;
+                g_set_error (error, G_FILE_ERROR, g_file_error_from_errno (saved_errno),
+                             "creating temporary icon file failed: %s", g_strerror (saved_errno));
+                return -1;
+        }
+
+        g_unlink (filename);
+
+        return fd;
+}
+#endif

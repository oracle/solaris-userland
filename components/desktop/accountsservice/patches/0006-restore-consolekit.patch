+                                                 G_DBUS_PROXY_FLAGS_NONE,
+                                                 CK_NAME,
+                                                 seat_id,
+                                                 NULL,
+                                                 &error);
+        if (proxy)
+                res = console_kit_seat_call_activate_session_sync (proxy,
+                                                                   session_id,
+                                                                   G_DBUS_CALL_FLAGS_ALLOW_INTERACTIVE_AUTHORIZATION,
+                                                                   -1,
+                                                                   NULL,
+                                                                   &error);
+
+        if (!res) {
+                g_warning ("Unable to activate session: %s", error->message);

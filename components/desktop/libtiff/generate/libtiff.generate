# Man pages are moved to man3tiff
<transform file path=usr/share/man/man3/ -> edit path /man3/ /man3tiff/>

# Removed mangled man pages from the generated report
<transform file path=[^/]+\.3tiff$ -> drop>

# Drop binaries from /usr/bin/$(MACH64)
<transform file path=usr/bin/.\(MACH64\)/ -> drop>

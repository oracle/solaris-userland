Reject GstVideoMeta planes with insufficient row or tile geometry, or an
extent outside the backing buffer or mapped memory. This completes the
CVE-2026-86476 fix for directly attached and deserialized metadata. Mark
alternate-field pool metadata as ONEFIELD so it describes its allocation.

Local follow-up to the incomplete fix in 1.28.8.  Reported upstream:
https://gitlab.freedesktop.org/gstreamer/gstreamer/-/work_items/5395

--- gst-plugins-base-1.28.8/gst-libs/gst/video/gstvideoutilsprivate.h
+++ gst-plugins-base-1.28.8/gst-libs/gst/video/gstvideoutilsprivate.h
@@ -27,6 +27,74 @@
 #define _GST_VIDEO_UTILS_PRIVATE_H_
 
 #include <gst/gst.h>
+#include "video-tile.h"
+
+/* Check the row or tile grid and the complete plane before mapping it. */
+static inline gboolean
+gst_video_meta_plane_extent (const GstVideoFormatInfo * finfo,
+    guint width, guint height, GstVideoFrameFlags flags, guint plane,
+    gint stride, guint64 * row_offset, guint64 * extent)
+{
+  guint field_height = (flags & GST_VIDEO_FRAME_FLAG_ONEFIELD) ?
+      height / 2 + height % 2 : height;
+
+  if (!finfo || !width || !height || width > G_MAXINT ||
+      height > G_MAXINT || plane >= finfo->n_planes)
+    return FALSE;
+
+  *row_offset = 0;
+  if (GST_VIDEO_FORMAT_INFO_IS_TILED (finfo)) {
+    GstVideoInfo canonical;
+    guint x_tiles = GST_VIDEO_TILE_X_TILES (stride);
+    guint y_tiles = GST_VIDEO_TILE_Y_TILES (stride);
+
+    if (stride < 0)
+      return FALSE;
+
+    if (!gst_video_info_set_format (&canonical, finfo->format, width,
+            field_height) ||
+        x_tiles < GST_VIDEO_TILE_X_TILES (canonical.stride[plane]) ||
+        y_tiles < GST_VIDEO_TILE_Y_TILES (canonical.stride[plane]) ||
+        (GST_VIDEO_FORMAT_INFO_TILE_MODE (finfo) ==
+            GST_VIDEO_TILE_MODE_ZFLIPZ_2X2 && (x_tiles & 1)))
+      return FALSE;
+    *extent = (guint64) x_tiles * y_tiles *
+        GST_VIDEO_FORMAT_INFO_TILE_SIZE (finfo, plane);
+  } else if (GST_VIDEO_FORMAT_INFO_HAS_PALETTE (finfo) && plane == 1) {
+    *extent = 256 * 4;
+  } else {
+    gint comp[GST_VIDEO_MAX_COMPONENTS];
+    guint64 min_stride = 0;
+    guint64 abs_stride = stride < 0 ? -(gint64) stride : stride;
+    guint rows;
+
+    gst_video_format_info_component (finfo, plane, comp);
+    if (comp[0] < 0)
+      return FALSE;
+    if (GST_VIDEO_FORMAT_INFO_IS_COMPLEX (finfo) ||
+        GST_VIDEO_FORMAT_INFO_PSTRIDE (finfo, comp[0]) == 0) {
+      GstVideoInfo canonical;
+      if (!gst_video_info_set_format (&canonical, finfo->format, width,
+              field_height))
+        return FALSE;
+      min_stride = canonical.stride[plane];
+    } else {
+      for (guint i = 0; i < GST_VIDEO_MAX_COMPONENTS && comp[i] >= 0; i++)
+        min_stride = MAX (min_stride,
+            (guint64) GST_VIDEO_FORMAT_INFO_SCALE_WIDTH (finfo, comp[i],
+                width) * GST_VIDEO_FORMAT_INFO_PSTRIDE (finfo, comp[i]));
+    }
+    if (abs_stride < min_stride)
+      return FALSE;
+    rows = GST_VIDEO_FORMAT_INFO_SCALE_HEIGHT (finfo, comp[0], field_height);
+    if (!rows)
+      return FALSE;
+    *extent = abs_stride * (rows - 1) + min_stride;
+    if (stride < 0)
+      *row_offset = abs_stride * (rows - 1);
+  }
+  return *extent > 0;
+}
 
 G_BEGIN_DECLS
 

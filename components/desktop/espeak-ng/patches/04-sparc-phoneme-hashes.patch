Bug 40248981 - accept the verified SPARC hash for the Abkhaz phoneme test

The Abkhaz phoneme vector produces different WAV samples on SPARC.
Use the verified SPARC hash for this vector.

--- espeak-ng-1.53.0.20261103/tests/common
+++ espeak-ng-1.53.0.20261103/tests/common
@@ -104,6 +104,9 @@
 	TEST_LANG=$1
 	EXPECTED=$2
 	TEST_TEXT=$3
+	if [ "$(uname -p)" = sparc ] && [ -n "$4" ]; then
+		EXPECTED=$4
+	fi
     test_wav $TEST_LANG $EXPECTED "[[$TEST_TEXT]]"
 }
 

Bound UTF-8 validation reads by the supplied Vorbis-comment length.
Source: https://github.com/xiph/flac/pull/938

diff --git a/src/libFLAC/format.c b/src/libFLAC/format.c
index 634a15b0b4..cba3cab915 100644
--- a/src/libFLAC/format.c
+++ b/src/libFLAC/format.c
@@ -318,19 +318,22 @@ FLAC_API uint32_t FLAC__format_seektable_sort(FLAC__StreamMetadata_SeekTable *se
  *   http://www.unicode.org/versions/corrigendum1.html
  * and a more clear explanation at the end of this section:
  *   http://www.cl.cam.ac.uk/~mgk25/unicode.html#utf-8
+ *
+ * 'len' is the number of bytes readable at 'utf8', or SIZE_MAX for a
+ * NUL-terminated string (the NUL is never a continuation byte)
  */
-static uint32_t utf8len_(const FLAC__byte *utf8)
+static uint32_t utf8len_(const FLAC__byte *utf8, size_t len)
 {
 	FLAC__ASSERT(0 != utf8);
 	if ((utf8[0] & 0x80) == 0) {
 		return 1;
 	}
-	else if ((utf8[0] & 0xE0) == 0xC0 && (utf8[1] & 0xC0) == 0x80) {
+	else if (len >= 2 && (utf8[0] & 0xE0) == 0xC0 && (utf8[1] & 0xC0) == 0x80) {
 		if ((utf8[0] & 0xFE) == 0xC0) /* overlong sequence check */
 			return 0;
 		return 2;
 	}
-	else if ((utf8[0] & 0xF0) == 0xE0 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80) {
+	else if (len >= 3 && (utf8[0] & 0xF0) == 0xE0 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80) {
 		if (utf8[0] == 0xE0 && (utf8[1] & 0xE0) == 0x80) /* overlong sequence check */
 			return 0;
 		/* illegal surrogates check (U+D800...U+DFFF and U+FFFE...U+FFFF) */
@@ -340,17 +343,17 @@ static uint32_t utf8len_(const FLAC__byte *utf8)
 			return 0;
 		return 3;
 	}
-	else if ((utf8[0] & 0xF8) == 0xF0 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80) {
+	else if (len >= 4 && (utf8[0] & 0xF8) == 0xF0 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80) {
 		if (utf8[0] == 0xF0 && (utf8[1] & 0xF0) == 0x80) /* overlong sequence check */
 			return 0;
 		return 4;
 	}
-	else if ((utf8[0] & 0xFC) == 0xF8 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80 && (utf8[4] & 0xC0) == 0x80) {
+	else if (len >= 5 && (utf8[0] & 0xFC) == 0xF8 && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80 && (utf8[4] & 0xC0) == 0x80) {
 		if (utf8[0] == 0xF8 && (utf8[1] & 0xF8) == 0x80) /* overlong sequence check */
 			return 0;
 		return 5;
 	}
-	else if ((utf8[0] & 0xFE) == 0xFC && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80 && (utf8[4] & 0xC0) == 0x80 && (utf8[5] & 0xC0) == 0x80) {
+	else if (len >= 6 && (utf8[0] & 0xFE) == 0xFC && (utf8[1] & 0xC0) == 0x80 && (utf8[2] & 0xC0) == 0x80 && (utf8[3] & 0xC0) == 0x80 && (utf8[4] & 0xC0) == 0x80 && (utf8[5] & 0xC0) == 0x80) {
 		if (utf8[0] == 0xFC && (utf8[1] & 0xFC) == 0x80) /* overlong sequence check */
 			return 0;
 		return 6;
@@ -373,7 +376,7 @@ FLAC_API FLAC__bool FLAC__format_vorbiscomment_entry_value_is_legal(const FLAC__
 {

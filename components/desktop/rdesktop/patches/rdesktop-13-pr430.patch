-	char result[CTRL_RESULT_SIZE], c, *escaped;
+	char result[CTRL_RESULT_SIZE], *escaped;
 
 	escaped = NULL;
+	fp = NULL;
 
 	if (!_ctrl_is_slave)
 		return -1;
@@ -503,15 +512,25 @@ send(s, "\n", 1, 0);
 
 	/* read result from master */
 	fp = fdopen(s, "r");
+	if (fp == NULL)
+	{
+		ret = -1;
+		goto bail_out;

+/* Reject invalid server RSA parameters before they reach GMP. */
+static RD_BOOL
+sec_rsa_public_key_valid(const uint8 *modulus, uint32 modulus_size, const uint8 *exponent)
+{
+	uint32 i;
+	RD_BOOL modulus_gt_one = False;
+	RD_BOOL exponent_gt_one = False;
+
+	if (modulus_size < SEC_MODULUS_SIZE || modulus_size > SEC_MAX_MODULUS_SIZE)
+		return False;
+
+	for (i = 0; i < modulus_size; i++)
+		if (modulus[i] > (i == 0 ? 1 : 0))
+			modulus_gt_one = True;
+
+	for (i = 0; i < SEC_EXPONENT_SIZE; i++)
+		if (exponent[i] > (i == 0 ? 1 : 0))
+			exponent_gt_one = True;
+
+	return modulus_gt_one && exponent_gt_one;
+}

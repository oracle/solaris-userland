# Use this trick to revert $(MACH32) expansions.
<transform file -> edit path "$(MACH32)" "$(M32)">
<transform file -> edit path "M32" "MACH32">

# We do not deliver 32-bit executable binaries.
<transform file path=usr/bin/\$\(MACH32\)/.* -> drop>

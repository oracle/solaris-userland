From ae2246afa744ff5a160c488aabe2ab2019eab5d4 Mon Sep 17 00:00:00 2001
From: Nicola Fontana <ntd@entidi.it>
Date: Tue, 24 May 2022 07:56:48 +0200
Subject: [PATCH] Use g_memdup2 if available

g_memdup() should be avoided if possible:

    https://nvd.nist.gov/vuln/detail/CVE-2021-27219

Taken from upstream:
https://github.com/lgi-devs/lgi/commit/ae2246afa744ff5a160c488aabe2ab2019eab5d4

--- lgi-0.9.2/lgi/marshal.c
+++ lgi-0.9.2/lgi/marshal.c
@@ -12,6 +12,13 @@ #include <string.h>
 #include <ffi.h>
 #include "lgi.h"
 
+/* Use g_memdup2 when available */
+#if GLIB_CHECK_VERSION(2, 68, 0)
+#define lgi_memdup  g_memdup2
+#else
+#define lgi_memdup  g_memdup
+#endif
+
 /* Checks whether given argument contains number which fits given
    constraints. If yes, returns it, otherwise throws Lua error. */
 static lua_Number
@@ -325,7 +332,7 @@ else
 	    *out_array = (gpointer *) lua_tolstring (L, narg, &size);
 
 	  if (transfer != GI_TRANSFER_NOTHING)
-	    *out_array = g_memdup (*out_array, size);
+	    *out_array = lgi_memdup (*out_array, size);
 
 	  *out_size = size;
 	}

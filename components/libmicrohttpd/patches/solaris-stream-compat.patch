+/* Stream callbacks deliberately retain the POSIX interface used by RAD. */
+ssize_t
+MHD_stream_result_ (ssize_t result, size_t requested)
+{
+  if (result >= 0)
+    return ((size_t) result <= requested) ? result : MHD_ERR_INVAL_;
+  switch (errno)
+  {
+  case EAGAIN:
+#if EWOULDBLOCK != EAGAIN
+  case EWOULDBLOCK:
+#endif
+  case EINTR:
+    return MHD_ERR_AGAIN_;
+  case ECONNRESET:
+    return MHD_ERR_CONNRESET_;
+  case EPIPE:
+    return MHD_ERR_PIPE_;
+  case ENOMEM:
+  case ENOBUFS:
+    return MHD_ERR_NOMEM_;
+  case EBADF:
+    return MHD_ERR_BADF_;
+  case EINVAL:
+    return MHD_ERR_INVAL_;
+  default:
+    return MHD_ERR_NOTCONN_;
+  }
+}

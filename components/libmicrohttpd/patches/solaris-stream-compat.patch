+_MHD_EXTERN int
+MHD_add_stream_connection (struct MHD_Daemon *daemon, void *stream,
+                          ReceiveCallback recv_cb, TransmitCallback send_cb)
+{
+  struct MHD_Connection *connection;
+
+  if ((NULL == daemon) || (daemon->shutdown) ||
+      (0 == (daemon->options & MHD_STREAM_FLAG_)) ||
+      (NULL == recv_cb) || (NULL == send_cb))
+  {
+    errno = EINVAL;
+    return MHD_NO;
+  }
+  connection = new_connection_prepare_ (daemon, MHD_INVALID_SOCKET,
+                                        NULL, 0, true, false, true, _MHD_YES);
+  if (NULL == connection)
+    return MHD_NO;
+  connection->stream_recv = recv_cb;
+  connection->stream_send = send_cb;
+  connection->stream_data = stream;
+  return new_connection_process_ (daemon, connection);
+}
+
+
+_MHD_EXTERN void *
+MHD_get_stream_connection_data (struct MHD_Connection *connection)
+{
+  return (NULL == connection) ? NULL : connection->stream_data;
+}

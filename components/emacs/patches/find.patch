# Ensure that emacs uses GNU find. See components/emacs/README.
#    16171813 emacs rgrep assumes gnu find in path; fails using
#            GNU-specific options
#
--- emacs-30.2.orig/lisp/ldefs-boot.el	2025-08-14 02:23:00.000000000 -0600
+++ emacs-30.2/lisp/ldefs-boot.el	2026-08-18 16:04:25.267192085 -0600
@@ -15149,7 +15149,7 @@
 (defvar grep-program (purecopy "grep") "\
 The default grep program for `grep-command' and `grep-find-command'.
 This variable's value takes effect when `grep-compute-defaults' is called.")
-(defvar find-program (purecopy "find") "\
+(defvar find-program (purecopy "/usr/gnu/bin/find") "\
 The default find program.
 This is used by commands like `grep-find-command', `find-dired'
 and others.")
--- emacs-30.2.orig/lisp/loaddefs.el	2025-08-14 02:15:59.000000000 -0600
+++ emacs-30.2/lisp/loaddefs.el	2026-08-18 16:04:42.755178981 -0600
@@ -15149,7 +15149,7 @@
 (defvar grep-program (purecopy "grep") "\
 The default grep program for `grep-command' and `grep-find-command'.
 This variable's value takes effect when `grep-compute-defaults' is called.")
-(defvar find-program (purecopy "find") "\
+(defvar find-program (purecopy "/usr/gnu/bin/find") "\
 The default find program.
 This is used by commands like `grep-find-command', `find-dired'
 and others.")
--- emacs-30.2.orig/lisp/progmodes/grep.el	2025-01-04 04:05:30.000000000 -0700
+++ emacs-30.2/lisp/progmodes/grep.el	2026-08-18 16:05:14.949715401 -0600
@@ -548,7 +548,7 @@
 This variable's value takes effect when `grep-compute-defaults' is called.")
 
 ;;;###autoload
-(defvar find-program (purecopy "find")
+(defvar find-program (purecopy "/usr/gnu/bin/find")
   "The default find program.
 This is used by commands like `grep-find-command', `find-dired'
 and others.")

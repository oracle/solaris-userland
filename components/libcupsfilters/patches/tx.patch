+typedef enum
+{
+  PAGE_LABEL_NONE,
+  PAGE_LABEL_STANDARD,
+  PAGE_LABEL_TX
+} page_label_mode_t;
+
+
+//
+// 'get_page_label_mode()' - Determine how page labels should be rendered.
+//
+
+static page_label_mode_t
+get_page_label_mode(const char *label)
+{
+  const char *content_type;
+
+  if (!label || !*label)
+    return (PAGE_LABEL_NONE);
+
+  if (!is_system_labeled())
+    return (PAGE_LABEL_STANDARD);
+
+  content_type = getenv("CONTENT_TYPE");
+  if (content_type &&
+      !strcmp(content_type, "application/vnd.cups-labeled-banner"))
+    return (PAGE_LABEL_NONE);
+
+  return (PAGE_LABEL_TX);
+}
+
+
+//
+// 'add_page_label()' - Add standard or Trusted Extensions page labels.
+//
+
+static void
+add_page_label(pdfio_stream_t       *st,
+               const pdfio_rect_t   *rect,
+               const char           *label,
+               page_label_mode_t    mode)
+{
+  const char *font = "SolarisPageLabelFont";
+  double     margin = 2.25,
+             font_height = 12.0,
+             frame_height = font_height + 2.0 * margin,
+             frame_width,
+             frame_x,
+             top_frame_y,
+             bottom_frame_y;
+
+  pdfioContentSave(st);
+
+  if (mode == PAGE_LABEL_TX)
+  {
+    frame_width = strlen(label) * 7.2 + 2.0 * margin;
+    frame_x = (rect->x1 + rect->x2 - frame_width) / 2.0;
+    top_frame_y = rect->y2 - frame_height;
+    bottom_frame_y = rect->y1;
+
+    pdfioContentSetFillColorDeviceGray(st, 0.0);
+    pdfioContentPathRect(st, frame_x, top_frame_y,
+                        frame_width, frame_height);
+    pdfioContentFill(st, false);
+    pdfioContentPathRect(st, frame_x, bottom_frame_y,
+                        frame_width, frame_height);
+    pdfioContentFill(st, false);
+
+    pdfioContentSetFillColorDeviceGray(st, 1.0);
+    pdfioContentTextBegin(st);
+    pdfioContentSetTextFont(st, font, font_height);
+    pdfioContentTextMoveTo(st, frame_x + margin,
+                          top_frame_y + 2.0 * margin);
+    pdfioContentTextShow(st, false, label);
+    pdfioContentTextEnd(st);
+
+    pdfioContentTextBegin(st);
+    pdfioContentSetTextFont(st, font, font_height);
+    pdfioContentTextMoveTo(st, frame_x + margin,
+                          bottom_frame_y + 2.0 * margin);
+    pdfioContentTextShow(st, false, label);
+    pdfioContentTextEnd(st);
+  }
+  else
+  {
+    frame_width = rect->x2 - rect->x1 - 2.0 * margin;
+    frame_x = rect->x1 + margin;
+    top_frame_y = rect->y2 - font_height - 2.0 * margin;
+    bottom_frame_y = rect->y1 + font_height + margin;
+
+    pdfioContentSetFillColorDeviceGray(st, 1.0);
+    pdfioContentSetStrokeColorDeviceGray(st, 0.0);
+    pdfioContentSetLineWidth(st, 1.0);
+    pdfioContentPathRect(st, frame_x, top_frame_y,
+                        frame_width, frame_height);
+    pdfioContentFillAndStroke(st, false);
+    pdfioContentPathRect(st, frame_x, bottom_frame_y,
+                        frame_width, frame_height);
+    pdfioContentFillAndStroke(st, false);
+
+    pdfioContentSetFillColorDeviceGray(st, 0.0);
+    pdfioContentTextBegin(st);
+    pdfioContentSetTextFont(st, font, font_height);
+    pdfioContentTextMoveTo(st, rect->x1 + 2.0 * margin,
+                          rect->y2 - font_height - margin);
+    pdfioContentTextShow(st, false, label);
+    pdfioContentTextEnd(st);
+
+    pdfioContentTextBegin(st);
+    pdfioContentSetTextFont(st, font, font_height);
+    pdfioContentTextMoveTo(st, rect->x1 + 2.0 * margin,
+                          rect->y1 + font_height + 2.0 * margin);
+    pdfioContentTextShow(st, false, label);
+    pdfioContentTextEnd(st);
+  }
+
+  pdfioContentRestore(st);
+}

 	free(hostbased_chost);
 	sshauthopt_free(key_opts);
 	key_blob = NULL;
 	key_bloblen = 0;
 	key_blobtype = MM_NOKEY;
 	key_opts = NULL;
-	hostbased_cuser = NULL;
 	hostbased_chost = NULL;
 }
 
@@ -1221,6 +1229,11 @@ int r;
 	if (!options.use_pam)
 		fatal_f("PAM not enabled");
 
+#ifdef HAVE_PAM_AUSER

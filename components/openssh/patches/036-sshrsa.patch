 int		 sshkey_names_valid2(const char *, int, int);
+#ifdef ENABLE_OPENSSL_FIPS
+int		 sshkey_convert_ssh_rsa(char *, char **);
+#endif
 char		*sshkey_alg_list(int, int, int, char);
 
 int	 sshkey_from_blob(const u_char *, size_t, struct sshkey **);

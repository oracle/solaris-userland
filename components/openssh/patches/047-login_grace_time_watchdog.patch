 		/* child */
 		close(pmonitor->m_sendfd);
 		close(pmonitor->m_log_recvfd);
+		grace_watchdog_pid = -1;
 
 		/*
 		 * Arrange unpriv-preauth child process fds:
@@ -1223,6 +1320,7 @@ main(int ac, char **av)
 
 		if (setitimer(ITIMER_REAL, &itv, NULL) == -1)
 			fatal("login grace time setitimer failed");
+		start_grace_watchdog(options.login_grace_time);
 	}
 
 	ssh_packet_set_nonblocking(ssh);
@@ -1257,6 +1355,7 @@ main(int ac, char **av)
 	if (setitimer(ITIMER_REAL, &itv, NULL) == -1)
 		fatal("login grace time clear failed");
 	ssh_signal(SIGALRM, SIG_DFL);
+	stop_grace_watchdog();
 	authctxt->authenticated = 1;

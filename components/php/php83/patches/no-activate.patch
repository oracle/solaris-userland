Don't automatically activate the Apache PHP object by editing
Apache's httpd.conf.
We choose to let the user do that manually.

Will not send this upstream.


--- php-8.3.33/sapi/apache2handler/config.m4
+++ php-8.3.33/sapi/apache2handler/config.m4
@@ -64,7 +64,7 @@ AC_MSG_ERROR([Please note that Apache ve
   fi
 
   APXS_LIBEXECDIR='$(INSTALL_ROOT)'`$APXS -q LIBEXECDIR`
-  if test -z `$APXS -q SYSCONFDIR`; then
+  if test -z ''; then
     INSTALL_IT="\$(mkinstalldirs) '$APXS_LIBEXECDIR' && \
                  $APXS -S LIBEXECDIR='$APXS_LIBEXECDIR' \
                        -i -n php"

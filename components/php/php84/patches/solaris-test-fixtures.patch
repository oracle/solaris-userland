+    && $actual["ino"] === $expected["ino"]
+    && $actual["mode"] === $expected["mode"]
+    && $actual["rdev"] === $expected["rdev"]);
+fclose($zero);
 fclose($fd);
 PHP;
 $process = proc_open([PHP_BINARY, "-n", "-r", $code], [1 => ["pipe", "w"]], $pipes);
@@ -25,5 +34,5 @@
 ?>

 $fd = fopen("/dev/null", "r");
-var_dump(readlink("/proc/self/fd/0"));
+// Solaris exposes /proc/self/fd entries without readlink() support.
+// Compare the reopened descriptor itself with /dev/null instead.
+$zero = fopen("php://fd/0", "r");

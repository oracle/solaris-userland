+        if (Object.hasOwn(Gio, prop))
+            return;
+
+        Object.defineProperty(Gio, prop, {
+            enumerable: true,
+            configurable: false,
+            get() {
+                return desc.get?.() ?? desc.value;
+            },
+        });
+    });

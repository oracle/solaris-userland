+++ b/schemas/org.gnome.desktop.wm.preferences.gschema.xml.in
@@ -185,7 +185,7 @@
       </description>
     </key>
     <key name="titlebar-font" type="s">
-      <default>'Adwaita Sans Bold 11'</default>
+      <default>'Cantarell Bold 11'</default>
       <summary>Window title font</summary>

+else
+  rust_library_name = '@0@rsvg_@1@.@2@'.format(lib_prefix, librsvg_api_major, ext_static)
+  rust_build_command = 'cbuild'
+endif
+
 rust_artifacts = custom_target(
   'librsvg-2',
   build_by_default: true,
-  output: '@0@rsvg_@1@.@2@'.format(lib_prefix, librsvg_api_major, ext_static),
+  output: rust_library_name,
   console: true,
   depend_files: library_sources + librsvg_c_sources,
   env: extra_env,

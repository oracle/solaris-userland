Solaris reports the rejected authentication connection as orderly EOF rather
than G_IO_ERROR_CONNECTION_CLOSED; accept that equivalent result in the test.

--- a/gio/tests/gdbus-auth.c
+++ b/gio/tests/gdbus-auth.c
@@ -355,9 +355,18 @@
                                   sizeof (read_buffer),
                                   NULL,
                                   &local_error);
-  g_assert_error (local_error, G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED);
-  g_assert_cmpint (read_len, <, 0);
-  g_clear_error (&local_error);
+  /* Solaris reports an orderly peer shutdown as EOF rather than a
+   * G_IO_ERROR_CONNECTION_CLOSED error. */
+  if (read_len == 0 && local_error == NULL)
+    {
+      /* The server rejected the over-long authentication line. */
+    }
+  else
+    {
+      g_assert_error (local_error, G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED);
+      g_assert_cmpint (read_len, <, 0);
+      g_clear_error (&local_error);
+    }
 
  write_buffer = g_strdup_printf ("AUTH\r\n");
 

Use ConsoleKit to find the greeter seat when systemd is unavailable, preserving
normal session selection. Skip Linux cgroup freeze detection on Solaris. The
new logind-only conflicting-session termination has no ConsoleKit equivalent;
return failure instead of linking against unavailable logind support.

--- a/common/gdm-common.c
+++ b/common/gdm-common.c
@@ -464,8 +464,8 @@
         return TRUE;
 }
 
-static char *
-get_current_seat_id (GDBusConnection *connection)
+char *
+gdm_get_current_seat_id (GDBusConnection *connection)
 {
         gboolean res;
         char    *session_id;
@@ -662,7 +662,7 @@
         /* First look for any existing LoginWindow sessions on the seat.
            If none are found, create a new one. */
 
-        seat_id = get_current_seat_id (connection);
+        seat_id = gdm_get_current_seat_id (connection);
         if (seat_id == NULL || seat_id[0] == '\0') {
                 g_debug ("seat id is not set; can't switch sessions");
                 g_set_error (error, GDM_COMMON_ERROR, 0, _("Could not identify the current session."));
@@ -916,6 +916,17 @@
 
         return ret;
 }
+#else
+gboolean
+gdm_terminate_session_by_id (GDBusConnection *connection,
+                             GCancellable    *cancellable,
+                             const char      *session_id)
+{
+        (void) connection;
+        (void) cancellable;
+        (void) session_id;
+        return FALSE;
+}
 #endif /* WITH_SYSTEMD */
 
 gboolean

Account for Solaris' 32K SQLite page size and skip a >2GB logger test
that cannot run in a 32-bit address space.

The generic logger-test failure is tracked upstream at
https://gitlab.gnome.org/GNOME/libsoup/-/issues/530.  The SQLite tests also
hardcode upstream's 4K default instead of deriving the database page size at
runtime; retain the Solaris workaround until that test is made portable.

--- a/tests/cookies-test.c
+++ b/tests/cookies-test.c
@@ -10,7 +10,11 @@
 
 // This is hardcoded to match sqlite but in theory could change some day.
 // https://sqlite.org/limits.html
+#ifdef __sun
+#define SQLITE_PAGE_SIZE 32768ULL
+#else
 #define SQLITE_PAGE_SIZE 4096ULL
+#endif
 #define SQLITE_MAX_PAGE_COUNT (G_MAXUINT32 - 1)
 
 static SoupServer *server;
@@ -867,6 +871,11 @@
 static void
 do_cookies_persistence_db_max_size_storage_test (gconstpointer user_data)
 {
+#ifdef __sun
+	g_test_skip ("Test data assumes SQLite's upstream 4K page size");
+	return;
+#endif
+
 	const CookiePersistenceMaxSizeStorageWriteTestData *test_data = user_data;
 	SoupCookieJar *jar;
 	const char *value = "";
@@ -1008,6 +1017,11 @@
 static void
 do_cookies_persistence_db_max_size_at_object_creation_storage_test (gconstpointer user_data)
 {
+#ifdef __sun
+	g_test_skip ("Test data assumes SQLite's upstream 4K page size");
+	return;
+#endif
+
 	const CookiePersistenceMaxSizeAtObjectCreationStorageWriteTestData *test_data = user_data;
 	SoupCookieJar *jar;
 	const char *value = "";
--- a/tests/logger-test.c
+++ b/tests/logger-test.c
@@ -468,6 +468,11 @@
 static void
 do_logger_long_invalid_body_length_test (void)
 {
+        if (sizeof (gsize) <= 4) {
+                g_test_skip ("Test requires a greater than 2GB address space");
+                return;
+        }
+
         SoupSession *session;
         SoupLogger *logger;
         GUri *uri;

Fix unaligned 64-bit pixel reads and writes on strict-alignment platforms.
Pixman permits image rows aligned to 4 bytes; direct uint64_t accesses can
therefore cause SIGBUS on SPARC64. Use the upstream memcpy implementation
for the a16b16g16r16 format.

The fix is merged upstream but is absent from the latest release, 0.46.4.
Source: https://gitlab.freedesktop.org/pixman/pixman/-/merge_requests/159

--- a/pixman/pixman-access.c
+++ b/pixman/pixman-access.c
@@ -725,7 +725,9 @@
 
     while (pixel < end)
     {
-	uint64_t p = READ (image, pixel++);
+	uint64_t p;
+
+	memcpy(&p, pixel++, sizeof(p));
 	uint64_t a = (p >> 48) & 0xffff;
 	uint64_t b = (p >> 32) & 0xffff;
 	uint64_t g = (p >> 16) & 0xffff;
@@ -943,7 +945,8 @@
 				int           line)
 {
     uint64_t *bits = (uint64_t *)(image->bits + line * image->rowstride);
-    uint64_t p = READ (image, bits + offset);
+    uint64_t p;
+    memcpy(&p, bits + offset, sizeof(p));
     uint64_t a = (p >> 48) & 0xffff;
     uint64_t b = (p >> 32) & 0xffff;
     uint64_t g = (p >> 16) & 0xffff;
@@ -1193,8 +1196,8 @@
 	g = pixman_float_to_unorm (values[i].g, 16);
 	b = pixman_float_to_unorm (values[i].b, 16);
 
-	WRITE (image, pixel++,
-	       (a << 48) | (b << 32) | (g << 16) | (r << 0));
+	uint64_t p = (a << 48) | (b << 32) | (g << 16) | (r << 0) ;
+	memcpy(pixel++, &p, sizeof(uint64_t));
     }
 }
 

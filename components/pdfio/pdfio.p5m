<transform file path=usr.*/man/.+ -> default mangler.man.stability uncommitted>
set name=pkg.fmri \
    value=pkg:/library/pdfio@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="PDF read/write library"
set name=com.oracle.info.baid value=$(COMPONENT_BAID)
set name=com.oracle.info.description value="PDF read/write library"
set name=info.classification \
    value=org.opensolaris.category.2008:System/Libraries
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.arc-caseid value=PSARC/2026/080
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
file path=usr/include/pdfio-content.h
file path=usr/include/pdfio.h
link path=usr/lib/$(MACH64)/libpdfio.so target=libpdfio.so.1
file path=usr/lib/$(MACH64)/libpdfio.so.1
file path=usr/lib/$(MACH64)/pkgconfig/pdfio.pc
dir  path=usr/share/doc group=other
dir  path=usr/share/doc/pdfio
file path=usr/share/doc/pdfio/LICENSE
file path=usr/share/doc/pdfio/NOTICE
dir  path=usr/share/doc/pdfio/examples
file path=usr/share/doc/pdfio/examples/Makefile
file path=usr/share/doc/pdfio/examples/Roboto-Bold.ttf
file path=usr/share/doc/pdfio/examples/Roboto-Italic.ttf
file path=usr/share/doc/pdfio/examples/Roboto-LICENSE.txt
file path=usr/share/doc/pdfio/examples/Roboto-Regular.ttf
file path=usr/share/doc/pdfio/examples/RobotoMono-Regular.ttf
file path=usr/share/doc/pdfio/examples/code128-LICENSE.txt
file path=usr/share/doc/pdfio/examples/code128.c
file path=usr/share/doc/pdfio/examples/code128.ttf
file path=usr/share/doc/pdfio/examples/image2pdf.c
file path=usr/share/doc/pdfio/examples/md2pdf.c
file path=usr/share/doc/pdfio/examples/md2pdf.md
file path=usr/share/doc/pdfio/examples/mmd.c
file path=usr/share/doc/pdfio/examples/mmd.h
file path=usr/share/doc/pdfio/examples/pdf2text.c
file path=usr/share/doc/pdfio/examples/pdfioinfo.c
file path=usr/share/doc/pdfio/pdfio-512.png
file path=usr/share/doc/pdfio/pdfio.html
file path=usr/share/man/man3/pdfio.3
license pdfio.license license="Apache v2.0"

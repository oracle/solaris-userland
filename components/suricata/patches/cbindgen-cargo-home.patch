The component Makefile sets up Userland's offline Cargo vendoring with these
lines:

    include $(WS_MAKE_RULES)/cargo-vendored.mk
    COMPONENT_PRE_BUILD_ACTION += $(VENDORED_SOURCES_ENFORCE)
    CONFIGURE_ENV += CARGO_HOME=$(COMPONENT_DIR)/build/.cargo

VENDORED_SOURCES_ENFORCE creates the build-local Cargo configuration which
redirects crates.io to the downloaded vendored sources, and CONFIGURE_ENV
passes that Cargo home to the generated upstream Makefiles.  The regular Cargo
build uses this configuration, but the upstream cbindgen commands do not pass
CARGO_HOME.  Because cbindgen runs "cargo metadata" internally, it then falls
back to the user's default Cargo home and may try to access crates.io.  This
caused the offline SPARC Userland build to stall.

Pass the configured CARGO_HOME to every cbindgen invocation so that its
metadata queries resolve dependencies from the vendored sources without
network access.

Not suitable for upstream because this solution is tied to the Userland Cargo
vendoring setup in the component Makefile.
---
--- a/rust/Makefile.am
+++ b/rust/Makefile.am
@@ -152,6 +152,6 @@ rust/src/jsonbuilder.rs: src/jsonbuilder
	cat sys/src/sys.rs.tmp >> sys/src/sys.rs
	rm -f sys/src/sys.rs.tmp
-	CARGO=$(CARGO) $(CBINDGEN) --quiet --config cbindgen.toml src/jsonbuilder.rs -o gen/jsonbuilder.h
+	CARGO_HOME="$(CARGO_HOME)" CARGO=$(CARGO) $(CBINDGEN) --quiet --config cbindgen.toml src/jsonbuilder.rs -o gen/jsonbuilder.h
 	$(BINDGEN) \
 		-o sys/src/jsonbuilder.rs.tmp \
 		--rust-target 1.68 \
@@ -172,7 +172,7 @@ endif
 if HAVE_CBINDGEN
 gen/rust-bindings.h: $(RUST_SURICATA_LIB) cbindgen.toml
 	cd $(abs_top_srcdir)/rust && \
-		CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/cbindgen.toml \
+		CARGO_HOME="$(CARGO_HOME)" CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/cbindgen.toml \
 		--quiet --verify --output $(abs_top_builddir)/rust/gen/rust-bindings.h || true
 else
 gen/rust-bindings.h:
@@ -181,7 +181,7 @@ endif
 if HAVE_CBINDGEN
 gen/htp/htp_rs.h: $(RUST_SURICATA_LIB) htp/cbindgen.toml
 	cd $(abs_top_srcdir)/rust/htp && \
-		CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/htp/cbindgen.toml \
+		CARGO_HOME="$(CARGO_HOME)" CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/htp/cbindgen.toml \
 		--quiet --verify --output $(abs_top_builddir)/rust/gen/htp/htp_rs.h || true
 else
 gen/htp/htp_rs.h:
@@ -192,7 +192,7 @@ rustdoc:
 
 if HAVE_CBINDGEN
 dist/rust-bindings.h:
-	CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/cbindgen.toml \
+	CARGO_HOME="$(CARGO_HOME)" CARGO=$(CARGO) $(CBINDGEN) --config $(abs_top_srcdir)/rust/cbindgen.toml \
 		--quiet --output $(abs_top_builddir)/rust/dist/rust-bindings.h
 else
 dist/rust-bindings.h:
@@ -201,7 +201,7 @@ endif
 if HAVE_CBINDGEN
 dist/htp/htp_rs.h:
 	cd $(abs_top_srcdir)/rust/htp && \
-	CARGO=$(CARGO) $(CBINDGEN) --config cbindgen.toml \
+	CARGO_HOME="$(CARGO_HOME)" CARGO=$(CARGO) $(CBINDGEN) --config cbindgen.toml \
 		--quiet --output $(abs_top_builddir)/rust/dist/htp/htp_rs.h
 else
 dist/htp/htp_rs.h:

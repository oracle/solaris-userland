+#include "suricata-common.h"
+#include "suricata.h"
+#include "action-globals.h"
+#include "decode.h"
+#include "packet.h"
+#include "source-dlpi.h"
+#include "tm-threads.h"
+#include "util-datalink.h"
+#include "util-device-private.h"
+#include "util-privs.h"
+#include "util-time.h"
+
+#ifdef HAVE_DLPI
+
+#include <libdlpi.h>
+
+#define DLPI_MAX_FRAME_SIZE 65536
+#define DLPI_POLL_TIMEOUT   100
+#define DLPI_MAX_BATCH      64
+#define DLPI_RECONNECT_US   500000
+
+typedef struct DLPIThreadVars_ {
+    dlpi_handle_t rx;
+    dlpi_handle_t tx;
+    ThreadVars *tv;
+    TmSlot *slot;
+    LiveDevice *livedev;
+    char iface[DLPI_IFACE_NAME_LENGTH];
+    char out_iface[DLPI_IFACE_NAME_LENGTH];
+    uint16_t capture_packets;
+    uint16_t capture_bytes;
+    uint16_t capture_drops;
+    uint16_t capture_send_errors;
+    uint64_t pkts;
+    uint64_t bytes;
+    uint64_t drops;
+    uint64_t send_errors;
+} DLPIThreadVars;
+
+static void DLPIPrintError(const char *operation, const char *iface, int error)
+{
+    if (error == DL_SYSERR) {
+        SCLogError("%s on %s failed: %s", operation, iface, strerror(errno));
+    } else {
+        SCLogError("%s on %s failed: %s", operation, iface, dlpi_strerror(error));
+    }
+}
+
+static int DLPILinkOpen(const char *iface, bool receive, dlpi_handle_t *handle)
+{
+    int ret = dlpi_open(iface, handle, DLPI_RAW);
+    if (ret != DLPI_SUCCESS) {
+        DLPIPrintError("dlpi_open", iface, ret);
+        return -1;
+    }
+
+    uint_t sap = 0;
+    ret = dlpi_bind(*handle, DLPI_ANY_SAP, &sap);
+    if (ret != DLPI_SUCCESS) {
+        DLPIPrintError("dlpi_bind", iface, ret);
+        goto error;
+    }
+
+    dlpi_info_t info;
+    ret = dlpi_info(*handle, &info, 0);
+    if (ret != DLPI_SUCCESS) {
+        DLPIPrintError("dlpi_info", iface, ret);
+        goto error;
+    }
+    if (info.di_mactype != DL_ETHER) {
+        SCLogError("DLPI link %s is not Ethernet", iface);
+        goto error;
+    }
+
+    if (receive) {
+        ret = dlpi_promiscon(*handle, DL_PROMISC_PHYS | DL_PROMISC_NOLOOP);
+        if (ret != DLPI_SUCCESS) {
+            DLPIPrintError("dlpi_promiscon", iface, ret);
+            goto error;
+        }
+
+        /* DLPI_ANY_SAP chooses a bind SAP; it does not disable SAP filtering. */
+        ret = dlpi_promiscon(*handle, DL_PROMISC_SAP | DL_PROMISC_NOLOOP);
+        if (ret != DLPI_SUCCESS) {
+            DLPIPrintError("dlpi_promiscon(SAP)", iface, ret);
+            goto error;
+        }
+    }
+    return 0;
+
+error:
+    dlpi_close(*handle);
+    *handle = NULL;
+    return -1;
+}
+
+static void DLPILinksClose(DLPIThreadVars *dtv)
+{
+    if (dtv->rx != NULL) {
+        dlpi_close(dtv->rx);
+        dtv->rx = NULL;
+    }
+    if (dtv->tx != NULL) {
+        dlpi_close(dtv->tx);
+        dtv->tx = NULL;
+    }
+}
+
+static inline void DLPIDumpCounters(DLPIThreadVars *dtv)
+{
+    StatsAddUI64(dtv->tv, dtv->capture_packets, dtv->pkts);
+    StatsAddUI64(dtv->tv, dtv->capture_bytes, dtv->bytes);
+    StatsAddUI64(dtv->tv, dtv->capture_drops, dtv->drops);
+    StatsAddUI64(dtv->tv, dtv->capture_send_errors, dtv->send_errors);
+    (void)SC_ATOMIC_ADD(dtv->livedev->pkts, dtv->pkts);
+    (void)SC_ATOMIC_ADD(dtv->livedev->drop, dtv->drops);
+    dtv->pkts = 0;
+    dtv->bytes = 0;
+    dtv->drops = 0;
+    dtv->send_errors = 0;
+}
+
+static void DLPIReleasePacket(Packet *p)
+{
+    DLPIThreadVars *dtv = p->dlpi_v.dtv;
+
+    if (!PKT_IS_PSEUDOPKT(p)) {
+        if (PacketCheckAction(p, ACTION_DROP)) {
+            dtv->drops++;
+        } else if (!PacketIsEthernet(p)) {
+            SCLogWarning("DLPI packet without Ethernet header was not forwarded");
+            dtv->drops++;
+        } else {
+            const int ret = dlpi_send(dtv->tx, NULL, 0, GET_PKT_DATA(p), GET_PKT_LEN(p), NULL);
+            if (ret != DLPI_SUCCESS) {
+                DLPIPrintError("dlpi_send", dtv->out_iface, ret);
+                dtv->send_errors++;
+                dtv->drops++;
+            }
+        }
+    }
+    PacketFreeOrRelease(p);
+}
+
+static TmEcode ReceiveDLPIThreadInit(ThreadVars *tv, const void *initdata, void **data)
+{
+    const DLPIIfaceConfig *cfg = initdata;
+    if (cfg == NULL) {
+        SCLogError("DLPI thread has no configuration");
+        return TM_ECODE_FAILED;
+    }
+
+    DLPIThreadVars *dtv = SCCalloc(1, sizeof(*dtv));
+    if (dtv == NULL) {
+        ((DLPIIfaceConfig *)cfg)->DerefFunc((void *)cfg);
+        return TM_ECODE_FAILED;
+    }
+    dtv->tv = tv;
+    strlcpy(dtv->iface, cfg->iface, sizeof(dtv->iface));
+    strlcpy(dtv->out_iface, cfg->out_iface, sizeof(dtv->out_iface));
+    dtv->livedev = LiveGetDevice(dtv->iface);
+    if (dtv->livedev == NULL) {
+        SCLogError("DLPI link %s is not a live device", dtv->iface);
+        goto error;
+    }
+    if (DLPILinkOpen(dtv->iface, true, &dtv->rx) != 0 ||
+            DLPILinkOpen(dtv->out_iface, false, &dtv->tx) != 0) {
+        goto error;
+    }
+
+    DatalinkSetGlobalType(LINKTYPE_ETHERNET);
+    dtv->capture_packets = StatsRegisterCounter("capture.dlpi_packets", tv);
+    dtv->capture_bytes = StatsRegisterCounter("capture.dlpi_bytes", tv);
+    dtv->capture_drops = StatsRegisterCounter("capture.dlpi_drops", tv);
+    dtv->capture_send_errors = StatsRegisterCounter("capture.dlpi_send_errors", tv);
+
+    ((DLPIIfaceConfig *)cfg)->DerefFunc((void *)cfg);
+    *data = dtv;
+    return TM_ECODE_OK;
+
+error:
+    DLPILinksClose(dtv);
+    SCFree(dtv);
+    ((DLPIIfaceConfig *)cfg)->DerefFunc((void *)cfg);
+    return TM_ECODE_FAILED;
+}
+
+static void DLPIProcessPacket(DLPIThreadVars *dtv, const uint8_t *buf, size_t len)
+{
+    Packet *p = PacketPoolGetPacket();
+    if (p == NULL) {
+        dtv->drops++;
+        return;
+    }
+
+    struct timeval ts;
+    (void)gettimeofday(&ts, NULL);
+    PKT_SET_SRC(p, PKT_SRC_WIRE);
+    p->livedev = dtv->livedev;
+    p->datalink = LINKTYPE_ETHERNET;
+    p->ts = SCTIME_FROM_TIMEVAL(&ts);
+    if (PacketCopyData(p, (uint8_t *)buf, len) == -1) {
+        TmqhOutputPacketpool(dtv->tv, p);
+        dtv->drops++;
+        return;
+    }
+    p->ReleasePacket = DLPIReleasePacket;
+    p->dlpi_v.dtv = dtv;
+    dtv->pkts++;
+    dtv->bytes += len;
+    (void)TmThreadsSlotProcessPkt(dtv->tv, dtv->slot, p);
+}
+
+static TmEcode ReceiveDLPILoop(ThreadVars *tv, void *data, void *slot)
+{
+    DLPIThreadVars *dtv = data;
+    struct pollfd fds[2] = {
+        { .fd = dlpi_fd(dtv->rx), .events = POLLIN },
+        { .fd = dlpi_fd(dtv->tx), .events = 0 },
+    };
+    bool link_down = false;
+    uint8_t buf[DLPI_MAX_FRAME_SIZE];
+    dtv->slot = ((TmSlot *)slot)->slot_next;
+    TmThreadsSetFlag(tv, THV_RUNNING);
+
+    for (;;) {
+        if (unlikely(suricata_ctl_flags != 0))
+            break;
+
+        /* Like AF_PACKET, back off and reopen after a link/read error. */
+        if (unlikely(link_down)) {
+            DLPILinksClose(dtv);
+            SleepUsec(DLPI_RECONNECT_US);
+            if (suricata_ctl_flags != 0)
+                break;
+            if (DLPILinkOpen(dtv->iface, true, &dtv->rx) != 0 ||
+                    DLPILinkOpen(dtv->out_iface, false, &dtv->tx) != 0)
+                continue;
+            fds[0].fd = dlpi_fd(dtv->rx);
+            fds[1].fd = dlpi_fd(dtv->tx);
+            link_down = false;
+        }
+
+        PacketPoolWait();
+        const int poll_ret = poll(fds, 2, DLPI_POLL_TIMEOUT);
+        if (suricata_ctl_flags != 0)
+            break;
+        if (poll_ret < 0) {
+            if (errno != EINTR) {
+                SCLogError("poll on DLPI link %s failed: %s", dtv->iface, strerror(errno));
+                link_down = true;
+            }
+        } else if (poll_ret == 0) {
+            TmThreadsCaptureHandleTimeout(tv, NULL);
+        } else if ((fds[0].revents | fds[1].revents) & (POLLERR | POLLHUP | POLLNVAL)) {
+            SCLogError("poll on DLPI links %s/%s returned error events 0x%x/0x%x", dtv->iface,
+                    dtv->out_iface, fds[0].revents, fds[1].revents);
+            link_down = true;
+        } else if (fds[0].revents & POLLIN) {
+            /* Bound each batch, as AF_PACKET bounds a pass over its RX ring. */
+            for (unsigned int n = 0; n < DLPI_MAX_BATCH; n++) {
+                if (unlikely(suricata_ctl_flags != 0))
+                    break;
+                size_t len = sizeof(buf);
+                dlpi_recvinfo_t info;
+                memset(&info, 0, sizeof(info));
+                const int ret = dlpi_recv(dtv->rx, NULL, NULL, buf, &len, 0, &info);
+                if (ret == DLPI_ETIMEDOUT)
+                    break;
+                if (ret != DLPI_SUCCESS) {
+                    if (ret == DL_SYSERR && errno == EINTR)
+                        break;
+                    DLPIPrintError("dlpi_recv", dtv->iface, ret);
+                    link_down = true;
+                    break;
+                }
+                if (info.dri_totmsglen > sizeof(buf)) {
+                    SCLogWarning("DLPI frame on %s was truncated (%zu bytes)", dtv->iface,
+                            info.dri_totmsglen);
+                    dtv->drops++;
+                    continue;
+                }
+                DLPIProcessPacket(dtv, buf, len);
+            }
+        }
+        DLPIDumpCounters(dtv);
+        StatsSyncCountersIfSignalled(tv);
+    }
+
+    DLPIDumpCounters(dtv);
+    StatsSyncCountersIfSignalled(tv);
+    return TM_ECODE_OK;
+}
+
+static void ReceiveDLPIThreadExitStats(ThreadVars *tv, void *data)
+{
+    DLPIThreadVars *dtv = data;
+    DLPIDumpCounters(dtv);
+    SCLogPerf("%s: (%s) DLPI packets %" PRIu64 ", bytes %" PRIu64 "", dtv->iface, tv->name,
+            StatsGetLocalCounterValue(tv, dtv->capture_packets),
+            StatsGetLocalCounterValue(tv, dtv->capture_bytes));
+}
+
+static TmEcode ReceiveDLPIThreadDeinit(ThreadVars *tv, void *data)
+{
+    (void)tv;
+    DLPIThreadVars *dtv = data;
+    if (dtv != NULL) {
+        DLPILinksClose(dtv);
+        SCFree(dtv);
+    }
+    return TM_ECODE_OK;
+}
+
+static TmEcode DecodeDLPIThreadInit(ThreadVars *tv, const void *initdata, void **data)
+{
+    (void)initdata;
+    DecodeThreadVars *dtv = DecodeThreadVarsAlloc(tv);
+    if (dtv == NULL)
+        return TM_ECODE_FAILED;
+    DecodeRegisterPerfCounters(dtv, tv);
+    *data = dtv;
+    return TM_ECODE_OK;
+}
+
+static TmEcode DecodeDLPI(ThreadVars *tv, Packet *p, void *data)
+{
+    DecodeThreadVars *dtv = data;
+    BUG_ON(PKT_IS_PSEUDOPKT(p));
+    DecodeUpdatePacketCounters(tv, dtv, p);
+    DecodeEthernet(tv, dtv, p, GET_PKT_DATA(p), GET_PKT_LEN(p));
+    PacketDecodeFinalize(tv, dtv, p);
+    return TM_ECODE_OK;
+}
+
+static TmEcode DecodeDLPIThreadDeinit(ThreadVars *tv, void *data)
+{
+    if (data != NULL)
+        DecodeThreadVarsFree(tv, data);
+    return TM_ECODE_OK;
+}
+
+void TmModuleReceiveDLPIRegister(void)
+{
+    tmm_modules[TMM_RECEIVEDLPI].name = "ReceiveDLPI";
+    tmm_modules[TMM_RECEIVEDLPI].ThreadInit = ReceiveDLPIThreadInit;
+    tmm_modules[TMM_RECEIVEDLPI].PktAcqLoop = ReceiveDLPILoop;
+    tmm_modules[TMM_RECEIVEDLPI].ThreadExitPrintStats = ReceiveDLPIThreadExitStats;
+    tmm_modules[TMM_RECEIVEDLPI].ThreadDeinit = ReceiveDLPIThreadDeinit;
+    tmm_modules[TMM_RECEIVEDLPI].cap_flags = SC_CAP_NET_RAW;
+    tmm_modules[TMM_RECEIVEDLPI].flags = TM_FLAG_RECEIVE_TM;
+}
+
+void TmModuleDecodeDLPIRegister(void)
+{
+    tmm_modules[TMM_DECODEDLPI].name = "DecodeDLPI";
+    tmm_modules[TMM_DECODEDLPI].ThreadInit = DecodeDLPIThreadInit;
+    tmm_modules[TMM_DECODEDLPI].Func = DecodeDLPI;
+    tmm_modules[TMM_DECODEDLPI].ThreadDeinit = DecodeDLPIThreadDeinit;
+    tmm_modules[TMM_DECODEDLPI].flags = TM_FLAG_DECODE_TM;
+}
+
+#else
+
+static TmEcode NoDLPISupportExit(ThreadVars *tv, const void *initdata, void **data)
+{
+    (void)initdata;
+    (void)data;
+    FatalError("Error creating thread %s: DLPI is not enabled. "
+               "Build Suricata with --enable-dlpi on Solaris.", tv->name);
+    return TM_ECODE_FAILED;
+}
+
+void TmModuleReceiveDLPIRegister(void)
+{
+    tmm_modules[TMM_RECEIVEDLPI].name = "ReceiveDLPI";
+    tmm_modules[TMM_RECEIVEDLPI].ThreadInit = NoDLPISupportExit;
+    tmm_modules[TMM_RECEIVEDLPI].flags = TM_FLAG_RECEIVE_TM;
+}
+
+void TmModuleDecodeDLPIRegister(void)
+{
+    tmm_modules[TMM_DECODEDLPI].name = "DecodeDLPI";
+    tmm_modules[TMM_DECODEDLPI].ThreadInit = NoDLPISupportExit;
+    tmm_modules[TMM_DECODEDLPI].flags = TM_FLAG_DECODE_TM;
+}

+static void DLPIDerefConfig(void *conf)
+{
+    DLPIIfaceConfig *cfg = conf;
+    if (SC_ATOMIC_SUB(cfg->ref, 1) == 1)
+        SCFree(cfg);
+}
+
+static int DLPIGetPeer(const char *iface, const char **peer)
+{
+    SCConfNode *node = SCConfGetNode("dlpi");
+    if (node == NULL)
+        return -1;
+
+    SCConfNode *if_root = ConfFindDeviceConfig(node, iface);
+    SCConfNode *if_default = ConfFindDeviceConfig(node, "default");
+    const char *mode = NULL;
+    const char *threads = NULL;
+
+    if (SCConfGetChildValueWithDefault(if_root, if_default, "copy-mode", &mode) != 1 ||
+            mode == NULL || strcmp(mode, "ips") != 0) {
+        SCLogError("dlpi.%s: copy-mode must be ips", iface);
+        return -1;
+    }
+    if (SCConfGetChildValueWithDefault(if_root, if_default, "copy-iface", peer) != 1 ||
+            *peer == NULL || **peer == '\0') {
+        SCLogError("dlpi.%s: copy-iface is required", iface);
+        return -1;
+    }
+    if (SCConfGetChildValueWithDefault(if_root, if_default, "threads", &threads) == 1 &&
+            threads != NULL && strcmp(threads, "1") != 0) {
+        SCLogError("dlpi.%s: only threads: 1 is supported", iface);
+        return -1;
+    }
+    return 0;
+}
+
+static bool DLPIIsLiveDevice(const char *iface)
+{
+    const int nlive = LiveGetDeviceCount();
+    for (int i = 0; i < nlive; i++) {
+        const char *live = LiveGetDeviceName(i);
+        if (live != NULL && strcmp(live, iface) == 0)
+            return true;
+    }
+    return false;
+}
+
+static int DLPIRunModeEnableIPS(void)
+{
+    /* Explicit --dlpi=<link> options are registered during argument
+     * parsing.  With bare --dlpi, populate the list from YAML here. */
+    if (LiveGetDeviceCount() == 0 && LiveBuildDeviceList("dlpi") > 0)
+        LiveDeviceFinalize();
+
+    const int nlive = LiveGetDeviceCount();
+    if (nlive < 2) {
+        SCLogError("DLPI IPS requires two reciprocal data links");
+        return -1;
+    }
+
+    for (int i = 0; i < nlive; i++) {
+        const char *iface = LiveGetDeviceName(i);
+        const char *peer = NULL;
+        const char *back_peer = NULL;
+        if (iface == NULL || DLPIGetPeer(iface, &peer) != 0)
+            return -1;
+        if (strcmp(iface, peer) == 0 || !DLPIIsLiveDevice(peer)) {
+            SCLogError("dlpi.%s: copy-iface %s is not a configured data link", iface, peer);
+            return -1;
+        }
+        if (DLPIGetPeer(peer, &back_peer) != 0 || strcmp(back_peer, iface) != 0) {
+            SCLogError("dlpi.%s and dlpi.%s must be reciprocal", iface, peer);
+            return -1;
+        }
+    }
+
+    EngineModeSetIPS();
+    return 1;
+}
+
+static void *ParseDLPIConfig(const char *iface)
+{
+    const char *peer = NULL;
+    if (iface == NULL || DLPIGetPeer(iface, &peer) != 0)
+        return NULL;
+
+    DLPIIfaceConfig *cfg = SCCalloc(1, sizeof(*cfg));
+    if (cfg == NULL)
+        return NULL;
+
+    if (strlcpy(cfg->iface, iface, sizeof(cfg->iface)) >= sizeof(cfg->iface) ||
+            strlcpy(cfg->out_iface, peer, sizeof(cfg->out_iface)) >= sizeof(cfg->out_iface)) {
+        SCLogError("DLPI link name is too long");
+        SCFree(cfg);
+        return NULL;
+    }
+    SC_ATOMIC_INIT(cfg->ref);
+    (void)SC_ATOMIC_ADD(cfg->ref, 1);
+    cfg->DerefFunc = DLPIDerefConfig;
+    return cfg;
+}
+
+static int DLPIConfigGetThreadsCount(void *conf)
+{
+    (void)conf;
+    return 1;
+}
+
+void RunModeIpsDLPIRegister(void)
+{
+    RunModeRegisterNewRunMode(RUNMODE_DLPI, "workers",
+            "Solaris DLPI inline L2 IPS mode", RunModeIpsDLPIWorkers, DLPIRunModeEnableIPS);
+}
+
+int RunModeIpsDLPIWorkers(void)
+{
+#ifdef HAVE_DLPI
+    TimeModeSetLive();
+    LiveDeviceHasNoStats();
+
+    const char *live_dev = NULL;
+    (void)SCConfGet("dlpi.live-interface", &live_dev);
+    const int ret = RunModeSetLiveCaptureWorkers(ParseDLPIConfig, DLPIConfigGetThreadsCount,
+            "ReceiveDLPI", "DecodeDLPI", thread_name_workers, live_dev);
+    if (ret != 0)
+        FatalError("Unable to start DLPI workers runmode");
+    return ret;
+#else
+    FatalError("DLPI support is not configured");
+    return -1;
+#endif
+}

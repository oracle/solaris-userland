+/* Names of directories already traversed, relative to the starting FD.
+   Each component ends in '/'.  Used only for confined resolution.  */
+struct resolved_path
+{
+  char *name;
+  idx_t len;
+  idx_t allocated;
+};
+
+/* Remember a successfully opened directory component.  Return a negative
+   errno on failure.  Keeping names rather than ancestor FDs permits deep
+   extraction even with a small file descriptor limit.  */
+static int
+remember_directory (struct resolved_path *path, char const *name, idx_t len)
+{
+  idx_t needed;
+  if (ckd_add (&needed, path->len, len)
+      || ckd_add (&needed, needed, 1))
+    return -ENOMEM;
+  if (path->allocated < needed)
+    {
+      idx_t size = ckd_add (&size, needed, needed >> 1) ? needed : size;
+      char *p = irealloc (path->name, size);
+      if (!p)
+        return negative_errno ();
+      path->name = p;
+      path->allocated = size;
+    }
+  memcpy (path->name + path->len, name, len);
+  path->name[needed - 1] = '/';
+  path->len = needed;
+  return 0;
+}

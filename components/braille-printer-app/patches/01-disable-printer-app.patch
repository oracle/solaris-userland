 # Systemd integration
--- a/Makefile.am
+++ b/Makefile.am
@@ -24,6 +24,7 @@ EXTRA_DIST = \
 # application
 # ===========
 
+if ENABLE_PRINTER_APP
 bin_PROGRAMS = brf-printer-app
 
 brf_printer_app_SOURCES = \
@@ -55,6 +56,7 @@ if HAVE_SYSTEMD
 dist_systemdsystemunit_DATA = \
	braille-printer-app/brf-printer-app.service
 endif
+endif
 
